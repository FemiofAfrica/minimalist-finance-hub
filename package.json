{
  "name": "minimalist-finance-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node dev-proxy.js",
    "groq-proxy": "node groq-api-proxy.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run proxy\" \"npm run groq-proxy\"",
    "type-check": "tsc --noEmit --skipLibCheck",
    "build": "vite build",
    "build:ci": "rm -rf dist && npm run type-check || true && npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "local-parser": "node super-simple-proxy.js",
    "dev:local": "node start-local-dev.js",
    "dev:mock": "concurrently \"npm run dev\" \"npm run local-parser\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
