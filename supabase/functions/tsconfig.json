{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "useUnknownInCatchVariables": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}